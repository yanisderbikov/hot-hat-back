# Скопировать в .env и заполнить. Сам .env в git не попадает.

# --- Порт HTTP. Railway задаёт PORT сам; локально и в docker-compose — 8092 ---
PORT=8092

# --- Postgres (локально поднимается через docker-compose, порт 5462) ---
POSTGRES_URL=jdbc:postgresql://localhost:5462/hot_hat
POSTGRES_USER=hothat
POSTGRES_PASSWORD=hothat

# --- CORS: домены фронтенда ---
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
URL_BACK=http://localhost:8092

# --- Права ---
HOT_HAT_OWNER_EMAIL=
ADMIN_EMAILS=
ADMIN_UIDS=
# Адрес фронтенда: из него собирается ссылка восстановления пароля
HOT_HAT_PUBLIC_URL=http://localhost:5000
# Внешний адрес этого бекенда: из него собираются ссылки на /api/media и вебхук Egress
HOT_HAT_API_PUBLIC_URL=http://localhost:8092
# Секрет для внешнего планировщика (/api/cleanup-rooms, /api/cleanup-recordings)
CRON_SECRET=

# --- Ошибки ---
# true: в теле 500 приходит причина исключения (поле detail). Удобно, пока
# игра не открыта людям; потом выключить — в причине может быть SQL.
HOT_HAT_ERRORS_EXPOSE_DETAILS=false

# --- Своя авторизация ---
# Минимум 32 байта, иначе приложение не стартует. Сгенерировать:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TURN (coturn) ---
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=7200

# --- S3-совместимое хранилище: записи партий и мем-видео ---
HOT_HAT_S3_ENDPOINT=
HOT_HAT_S3_REGION=us-east-1
HOT_HAT_S3_BUCKET=
HOT_HAT_S3_ACCESS_KEY=
HOT_HAT_S3_SECRET_KEY=
HOT_HAT_S3_FORCE_PATH_STYLE=true

# --- Метрики машины (читаются локально из /proc) ---
# Секрет для внешнего вызова /api/monitor планировщиком
HOT_HAT_MONITOR_SECRET=
HOT_HAT_DISK_ROOT=/
# Заполнять, только если на машине остались локальные мем-видео (обычно они в S3)
HOT_HAT_MEDIA_ROOT=
HOT_HAT_VPS_MONTHLY_TRAFFIC_LIMIT_GB=0

# --- Отчёты о расходе ресурсов (Resend). Пусто = письма не шлются ---
RESEND_API_KEY=
REPORT_EMAIL=
REPORT_FROM=HOT-HAT Monitor <onboarding@resend.dev>
REPORT_HOUR=23
REPORT_TIMEZONE=Asia/Yekaterinburg

# --- Расписания вместо секции crons из vercel.json ---
CLEANUP_ROOMS_CRON=0 20 2 * * *
CLEANUP_RECORDINGS_CRON=0 40 2 * * *
MONITOR_COLLECT_CRON=0 0 5,11,17,23 * * *
